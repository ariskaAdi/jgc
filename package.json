{
  "name": "aibot-js",
  "version": "2.0.0",
  "private": true,
  "description": "AI assistant untuk menjawab soal ujian (pilihan ganda & esai) — Express + TypeScript, deploy di Vercel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.1"
  }
}
