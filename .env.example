# ─── Gemini (primer, juga dipakai untuk soal gambar) ─────────────────────────
# API key: https://aistudio.google.com/apikey
# Satu key cukup di GEMINI_API_KEY. Untuk beberapa key, pakai GEMINI_API_KEY1, GEMINI_API_KEY2, ...
# Key berikutnya dipakai saat kuota key sebelumnya habis (HTTP 429).
# Kuota dihitung PER PROJECT, jadi rotasi hanya berguna jika tiap key dari project berbeda.
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# ─── Groq (fallback opsional untuk soal teks & screenshot) ───────────────────
# API key: https://console.groq.com/keys — kosongkan untuk mematikan fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Model untuk soal screenshot saat semua key Gemini gagal. Isi "off" untuk mematikan.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=10

# ─── Akses API ────────────────────────────────────────────────────────────────
# Wajib. Dikirim extension lewat header X-API-Key. Buat string acak yang panjang,
# misalnya: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=

# ─── Lock request ─────────────────────────────────────────────────────────────
# Hanya satu request AI yang diproses dalam satu waktu. Request lain ditolak (429)
# sampai yang berjalan selesai, atau paling lama sekian detik lalu dibatalkan.
# Jaga agar GEMINI_TIMEOUT_SECONDS + GROQ_TIMEOUT_SECONDS <= nilai ini.
REQUEST_HOLD_SECONDS=30

# ─── Lainnya ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info
# Port untuk `npm run dev` (lokal saja, Vercel tidak memakai ini)
PORT=8080
